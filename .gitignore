# Dependensi
node_modules/

# Database SQLite (dibuat otomatis saat server pertama dijalankan)
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.*

# Foto/gambar binary tidak ikut push (file besar, & gambar saat ini hanya
# contoh sementara — toko mengganti dengan foto asli). Upload foto asli via
# GitHub web (drag-drop ke app/public/img/) atau copy langsung ke server.
# Aplikasi otomatis memakai img/placeholder.svg bila file gambar tidak ada.
app/public/img/*.jpg
app/public/img/*.jpeg
app/public/img/*.png

# Environment
.env

# File internal agen (bukan bagian aplikasi)
hidden_files/
crons/
agent_notes/
incoming-photos/

# Sistem
.DS_Store
Thumbs.db
